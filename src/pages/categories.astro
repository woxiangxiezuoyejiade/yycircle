---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();
---

<MainGridLayout title="Categories" description="Browse writing by category.">
	<div class="card-base w-full p-6">
		<div class="mb-6">
			<p class="mb-2 text-sm font-semibold uppercase tracking-[0.24em] text-neutral-500">
				Browse
			</p>
			<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">Categories</h1>
		</div>
		<div class="grid gap-3 md:grid-cols-2">
			{categories.map((category) => (
				<a href={category.url} class="rounded-xl border border-(--line-divider) px-4 py-4 transition hover:border-(--primary) hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
					<div class="flex items-center justify-between gap-4">
						<span class="text-base font-medium text-neutral-900 dark:text-neutral-100">
							{category.name}
						</span>
						<span class="rounded-md bg-(--btn-regular-bg) px-2.5 py-1 text-xs font-semibold text-(--btn-content)">
							{category.count}
						</span>
					</div>
				</a>
			))}
		</div>
	</div>
</MainGridLayout>
